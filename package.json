{
  "name": "dnc-screening",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=backend/.env --watch backend/src/server.ts\" \"node frontend/scripts/next.mts dev\"",
    "build": "pnpm --filter @dnc/backend typecheck && node frontend/scripts/next.mts build",
    "db:setup": "node --env-file-if-exists=backend/.env backend/src/db/setup.ts",
    "db:migrate": "node --env-file-if-exists=backend/.env backend/src/db/setup.ts migrate",
    "db:seed": "node --env-file-if-exists=backend/.env backend/src/db/setup.ts seed",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
