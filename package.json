{
  "name": "dnc-screening",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=backend/.env --watch backend/src/server.js\" \"node frontend/scripts/next.mjs dev\"",
    "build": "node frontend/scripts/next.mjs build",
    "db:setup": "node --env-file-if-exists=backend/.env backend/src/db/setup.js",
    "db:migrate": "node --env-file-if-exists=backend/.env backend/src/db/setup.js migrate",
    "db:seed": "node --env-file-if-exists=backend/.env backend/src/db/setup.js seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
