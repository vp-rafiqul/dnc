{
  "name": "dnc-screening",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @dnc/backend dev\" \"node frontend/scripts/next.mts dev\"",
    "build": "pnpm --filter @dnc/backend typecheck && node frontend/scripts/next.mts build",
    "db:setup": "pnpm --filter @dnc/backend db:setup",
    "db:generate": "pnpm --filter @dnc/backend db:generate",
    "db:migrate": "pnpm --filter @dnc/backend db:migrate",
    "db:baseline": "pnpm --filter @dnc/backend db:baseline",
    "db:seed": "pnpm --filter @dnc/backend db:seed",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
