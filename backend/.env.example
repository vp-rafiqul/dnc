DATABASE_URL=postgresql://dnc:dnc_local@127.0.0.1:5432/dnc
POSTGRES_DB=dnc
POSTGRES_USER=dnc
POSTGRES_PASSWORD=dnc_local
POSTGRES_PORT=5432
JWT_SECRET=
API_KEY_ENCRYPTION_SECRET=
HISTORY_SEARCH_SECRET=
SAN_ENCRYPTION_KEYS=
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
# Optional: card payments through Stripe Checkout. Leave empty to offer bank transfer only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: with a publishable key, the card form opens inside the app (Stripe Embedded Checkout) instead of redirecting.
STRIPE_PUBLISHABLE_KEY=
# 3D Secure for card payments: any (default, request whenever supported), automatic (only when the bank requires it) or challenge.
STRIPE_THREE_D_SECURE=any
