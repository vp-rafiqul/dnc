{
  "name": "@dnc/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env src/db/setup.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/setup.js migrate",
    "db:seed": "node --env-file-if-exists=.env src/db/setup.js seed"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  }
}
