{
  "name": "@dnc/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "db:setup": "node --env-file-if-exists=.env src/db/setup.ts",
    "db:migrate": "node --env-file-if-exists=.env src/db/setup.ts migrate",
    "db:seed": "node --env-file-if-exists=.env src/db/setup.ts seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.0.0",
    "typescript": "~5.9.3"
  }
}
